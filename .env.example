# KukeChat Server 配置模板
#
# 复制为 .env 后填写。仓库不内置任何生产地址或密钥。

# ============================================================ 必填

# 令牌签名密钥。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# 未设置、仍是占位值或长度不足 32 时，服务启动会直接失败 —— 这是刻意的：
# 可预测的签名密钥意味着任何人都能伪造任意用户（含管理员）的令牌。
JWT_SECRET_KEY=

# ============================================================ 基础

APP_NAME=KukeChat API
DATABASE_URL=sqlite+aiosqlite:///./kukechat.db
# 匿名 HTTP 与 WebSocket/Redis 字节账聚合；默认关闭，排查期间短期设 true。
# 每 worker 每 60 秒分别输出非空 HTTP/WS 汇总；仅计应用接受的载荷字节，非公网/CDN/TLS 实际流量或客户端收讫。
TRANSPORT_METRICS_ENABLED=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 会话 Cookie。留空 COOKIE_SESSION_DOMAIN 表示只对当前域生效（推荐）；
# 只有需要跨子域共享登录态时才填，例如 .example.com
COOKIE_SESSION_NAME=kukechat_session
COOKIE_SESSION_DOMAIN=
COOKIE_SESSION_DAYS=30
# 生产环境必须保持 true（仅通过 HTTPS 传输 Cookie）
COOKIE_SECURE=true

# ============================================================ 跨域
#
# 必须包含你的前端来源，否则浏览器端会被 CORS 拦下。
# 默认值只含本地开发地址。

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://tauri.localhost","https://tauri.localhost"]
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|tauri\.localhost)(:\d+)?

# ============================================================ 实时消息
#
# 单进程部署可留空。多进程 / 多实例时必须配置 Redis，
# 否则 WebSocket 消息无法跨进程广播。

REDIS_URL=
REALTIME_REDIS_CHANNEL=kukechat:realtime
WEB_CONCURRENCY=
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30

# ============================================================ 存储

# local = 存本地 uploads/ 目录；s3 = 存对象存储
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_URL=

IMAGE_QUALITY=82
IMAGE_MAX_DIMENSION=2048
IMAGE_THUMBNAIL_MAX_DIMENSION=360

# ============================================================ 内容自动审核
#
# 本项目不自带审核服务，需要你自行接入一个提供 POST /moderate 的服务。
# 保持 false 时所有内容直接通过，仅保留人工举报处置流程。
# 设为 true 时必须同时填写 CONTENT_MODERATION_URL，否则启动失败。

CONTENT_MODERATION_ENABLED=false
CONTENT_MODERATION_URL=
# 审核服务的共享密钥（X-Moderation-Token 请求头），留空则不带
CONTENT_MODERATION_TOKEN=
CONTENT_MODERATION_TIMEOUT_SECONDS=30
CONTENT_MODERATION_RETRY_INTERVAL_SECONDS=300
CONTENT_MODERATION_RETRY_MIN_AGE_SECONDS=120
CONTENT_MODERATION_RETRY_BATCH_SIZE=20
# 审核服务对文本拿不准（review）时是否先撤回。默认只留记录等人工，不撤回
CONTENT_MODERATION_TEXT_REVIEW_RECALL=false

# 审核服务异常时的告警收件人，留空则不发送
MODERATION_ALERT_EMAIL=
MODERATION_ALERT_COOLDOWN_MINUTES=30

# ============================================================ 风纪委员
#
# 都有默认值，一般不用填；完整列表见 app/core/config.py 里 JURY_ 开头的项。
# 改了之后客户端通过 GET /jury/config 自动拿到新数字。

# 进入委员队列后多久没有结论就转给管理员
JURY_TIMEOUT_HOURS=72
# 公开群成员数达到这个值后，不再按群成员回避，只回避案件上下文里的发言人
JURY_LARGE_GROUP_MEMBERS=200
# 定案后多久内委员还能回看案件内容 / 多久之后进公示栏
JURY_CONTENT_RETENTION_DAYS=30
JURY_PUBLISH_DELAY_HOURS=72
# 总览里的比率至少要这么多样本才给
JURY_OVERVIEW_MIN_SAMPLE=5

# ============================================================ CCW 账号绑定
#
# 用户在指定 CCW 作品下留言，服务端轮询评论完成校验。
# 两项都填才会启用；留空则该功能整体不可用。
# GUEST_ID 请填你自己的访客标识，不要复用他人的。

CCW_BIND_SUBJECT_OID=
CCW_BIND_GUEST_ID=
CCW_BIND_SUBJECT_TYPE=CREATION
CCW_BIND_POLL_INTERVAL_SECONDS=20
CCW_BIND_CHALLENGE_MINUTES=20

# ============================================================ 邮件

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=KukeChat Server
SMTP_USE_SSL=true

# ============================================================ 邀请链接
#
# 邀请链接的落地页，用户打开即可加入群聊 / 添加好友。
# 通常指向你部署了 KukeChat 客户端的页面。

INVITE_BASE_URL=http://localhost:5173

# ============================================================ 任务提醒

TASK_REMINDER_CHECK_INTERVAL_SECONDS=60
TASK_REMINDER_ADVANCE_HOURS=24
